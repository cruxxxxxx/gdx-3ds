# Which submodules you actually need depends on the lane.
#
#   3DS, shipped config (O3DS/N3DS):      decomp torch   (torch supplies lib/libmio0)
#   3DS, Expansion Kit config (*-EK):     decomp torch fzerox-expansion-kit
#   PC-side asset extractor:              torch
#   Desktop G-Diffuser build:             all four, libultraship included
#
# The 3DS lane does NOT need libultraship: the 36 sources + 83 headers the console
# compiles are vendored in-tree at port/3ds/vendor/lus/ with every 3DS patch already
# folded in (port/3ds/vendor/lus/PROVENANCE.md). Initialise by name rather than with
# --recursive so a 3DS checkout stays small.
#
# fzerox-expansion-kit IS needed for an Expansion Kit build (-DGDX_3DS_EXPANSION_KIT=ON):
# tools/gen_ek_assets.py reads this submodule's assets/yaml/jp/**/*.yaml and tools/patch.py
# at CMake configure time to generate the (gitignored, disk-derived) EK asset sources —
# there is no prebaked fallback, so an EK configure fails outright without it. The shipped
# O3DS/N3DS targets never evaluate any of that and do not need it.
#
#   git submodule update --init decomp torch                          # O3DS / N3DS
#   git submodule update --init decomp torch fzerox-expansion-kit     # O3DS-EK / N3DS-EK
#
[submodule "libultraship"]
	path = libultraship
	url = https://github.com/Zorkats/libultraship.git
[submodule "torch"]
	path = torch
	url = https://github.com/Zorkats/Torch.git
[submodule "decomp"]
	path = decomp
	url = https://github.com/Zorkats/fzerox.git
# fzerox-expansion-kit is pinned to a history-rewritten copy of inspectredc's decomp
# (via Zorkats' fork) with the accidentally committed retail disk image (baserom.jp.disk)
# purged from every commit. The pinned commit's tree is identical to the old pin 6cd71e6
# minus that one file. It must be a standalone repo, NOT a GitHub "Fork" of upstream: a
# fork shares upstream's object network, so the purged blob would stay reachable.
# >>> FORK URL: the url line below assumes the clean repo is pushed to
# >>> github.com/cruxxxxxx/fzerox-expansion-kit. Change only that line if it lives elsewhere.
[submodule "fzerox-expansion-kit"]
	path = fzerox-expansion-kit
	url = https://github.com/cruxxxxxx/fzerox-expansion-kit.git
