+#ifdef PORT
+/* MP30: the CPU field of a VS COM race with more than 4 racers (online, 8..30 machines). Same
+   draws as stock (Rand2 character, Rand1 skin, from the seeds the session pinned), but a CPU
+   re-draws until its CHARACTER is one no racer before it has, so a 30-machine field shows every
+   pilot rather than a handful of repeats. The humans take at most gNumPlayers characters and
+   there are 30, so a free one always exists; the try bound is only a guard. */
+static void Racer_GdxFillCpuField(void) {
+    s32 i;
+    s32 j;
+    s32 tries;
+
+    for (i = gNumPlayers; i < gTotalRacers; i++) {
+        for (tries = 0; tries < 4096; tries++) {
+            gRacers[i].character = (Math_Rand2() & 0x1FFFF) % 30;
+            gRacers[i].machineSkinIndex = (Math_Rand1() & 0x1FFFF) % 4;
+            for (j = 0; j < i; j++) {
+                if (gRacers[i].character == gRacers[j].character) {
+                    break;
+                }
+            }
+            if (j == i) {
+                break;
+            }
+        }
+    }
+}
+
+/* MP30: the VS results field (ovl_i3/menus.c GDX_VS_FIELD / GDX_VS_PLACE and the points below).
+   Stock VS tables are sized for 4 racers; with more, the results rank the human players only. */
+s32 gdx_vs_field(void) {
+    return (gTotalRacers > 4) ? gNumPlayers : gTotalRacers;
+}
+
+s32 gdx_vs_place(s32 racerIndex) {
+    s32 j;
+    s32 place = 1;
+
+    if (gTotalRacers <= 4) {
+        return gRacers[racerIndex].position;
+    }
+    for (j = 0; j < gNumPlayers; j++) {
+        if ((j != racerIndex) && (gRacers[j].position < gRacers[racerIndex].position)) {
+            place++;
+        }
+    }
+    return place;
+}
+#endif
+
