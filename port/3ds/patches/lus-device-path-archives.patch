+// devkitPro/newlib device paths ("sdmc:/3ds/...") parse as RELATIVE under
+// std::filesystem's POSIX grammar (the "sdmc:" prefix is an ordinary first
+// component), so std::filesystem::absolute() prepends the cwd and produces
+// "/sdmc:/3ds/..." -- a path no devoptab matches (fopen fails with ENOSYS).
+// Treat a device-prefixed path as already absolute and pass it through
+// untouched. On Windows, drive paths use '\\' or are already absolute, so this
+// never triggers and absolute() keeps its normal behavior.
+static std::string ResolveArchivePath(const std::filesystem::path& path) {
+    const std::string raw = path.string();
+    const auto colon = raw.find(':');
+    if (colon != std::string::npos && colon > 0 && colon + 1 < raw.size() && raw[colon + 1] == '/') {
+        return raw;
+    }
+    return std::filesystem::absolute(path).string();
+}
+
 ArchiveManager::ArchiveManager() {
 }
 
