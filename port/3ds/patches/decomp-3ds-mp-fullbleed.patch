         if ((j) != (k)) {             \
             gfx = gdxFvMark;          \
         }                             \
+    } while (0)
+
+/* mp-fullbleed (decomp-3ds-mp-fullbleed.patch): under the 1P widescreen frame kind the local HUD
+ * takes Hud_DrawHud case 1's anchor scopes (TIME / timer / energy right, LAP left, the interval
+ * and the reverse warning centred); 0 = unanchored (widescreen off, or [net] mp_fullview_wide = 0). */
+#define GDX_FV_ANCHOR_SET(on, mode)          \
+    do {                                     \
+        if (on) {                            \
+            gSPSetExtraGeometryMode(gfx++, mode); \
+        }                                    \
+    } while (0)
+#define GDX_FV_ANCHOR_CLEAR(on, mode)          \
+    do {                                       \
+        if (on) {                              \
+            gSPClearExtraGeometryMode(gfx++, mode); \
+        }                                      \
     } while (0)
 
 static Gfx* Hud_GdxFullviewDrawHud(Gfx* gfx, s32 k) {
+    extern int gdx_widescreen_ui_active(void); // port/input_bridge.c
     s32 npi = gNumPlayers - 1;
     s32 j;
+    s32 wide = gdx_widescreen_ui_active() && GDX_FV_WIDE_1P(k);
 
     Hud_GdxFullviewLayout(k);
+    GDX_FV_ANCHOR_SET(wide, G_EX_WIDESCREEN_ANCHOR_RIGHT);
 
     // Time (the 1P label; pure drawing)
     gDPPipeSync(gfx++);
@@ -1217,18 +1236,22 @@
     for (j = 0; j < gNumPlayers; j++) {
         GDX_FV_HUD_CALL(j, k, Hud_UpdatePlayerHudInfo(gfx, (j == k) ? 0 : npi, j));
     }
+    GDX_FV_ANCHOR_CLEAR(wide, G_EX_WIDESCREEN_ANCHOR_RIGHT);
     for (j = 0; j < gNumPlayers; j++) {
         GDX_FV_HUD_CALL(j, k,
                         Hud_UpdateRaceIntervalInfo(gfx, (j == k) ? 0 : npi, j, ((j == k) || (npi < 2)) ? 1.0f : 0.75f));
     }
 
     // Energy Bar
+    GDX_FV_ANCHOR_SET(wide, G_EX_WIDESCREEN_ANCHOR_RIGHT);
     gDPPipeSync(gfx++);
     gDPLoadTextureBlock(gfx++, aHudEnergyTex, G_IM_FMT_RGBA, G_IM_SIZ_16b, 72, 16, 0, G_TX_NOMIRROR | G_TX_WRAP,
                         G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
     for (j = 0; j < gNumPlayers; j++) {
         GDX_FV_HUD_CALL(j, k, Hud_DrawEnergyOutlineRectangle(gfx, (j == k) ? 0 : npi, j));
     }
+    GDX_FV_ANCHOR_CLEAR(wide, G_EX_WIDESCREEN_ANCHOR_RIGHT);
+    GDX_FV_ANCHOR_SET(wide, G_EX_WIDESCREEN_ANCHOR_LEFT);
 
     // Lap
     gDPPipeSync(gfx++);
@@ -1245,10 +1268,13 @@
     for (j = 0; j < gNumPlayers; j++) {
         GDX_FV_HUD_CALL(j, k, Hud_DrawLapCounter(gfx, (j == k) ? 0 : npi, j));
     }
+    GDX_FV_ANCHOR_CLEAR(wide, G_EX_WIDESCREEN_ANCHOR_LEFT);
 
+    GDX_FV_ANCHOR_SET(wide, G_EX_WIDESCREEN_ANCHOR_RIGHT);
     for (j = 0; j < gNumPlayers; j++) {
         GDX_FV_HUD_CALL(j, k, Hud_DrawEnergyBar(gfx, (j == k) ? 0 : npi, j));
     }
+    GDX_FV_ANCHOR_CLEAR(wide, G_EX_WIDESCREEN_ANCHOR_RIGHT);
     for (j = 0; j < gNumPlayers; j++) {
         GDX_FV_HUD_CALL(j, k, Hud_DrawReverse(gfx, (j == k) ? 0 : npi, j));
     }
