diff --git a/include/fast/interpreter.h b/include/fast/interpreter.h
index a7b7ffa..c5436e8 100644
--- a/include/fast/interpreter.h
+++ b/include/fast/interpreter.h
@@ -337,7 +337,38 @@ struct RDP {
     } texture_to_load;
     // One entry per 64-bit TMEM word address: multiple render tiles can point at independent
     // loads within the same 4 KiB image.
+    //
+    // LOADBLOCK-OPT: StoreLoadedTexture used to materialize a full LoadedTexture at EVERY
+    // covered TMEM word — a 4 KiB load was 512 struct copies (each with a shared_ptr
+    // refcount pair inside raw_tex_metadata) plus a 512-entry overlap-invalidation walk of
+    // struct clears; measured on the 3DS as the #1 CPU cost ([profop] F3 = 22.34 ms/frame
+    // over 82 loads). A load is now ONE span record (the word-0 view, stored eagerly at the
+    // span's base slot) plus per-word bookkeeping bytes; per-word views materialize lazily,
+    // on first read, with EXACTLY the math the old store loop used, so every consumer sees
+    // byte-identical data. Read only through LoadedTextureAt(); the two in-place mutators
+    // (GfxDpImageRectangle, the port's VI present fallback) go through
+    // MutableLoadedTextureAt(), which materializes the whole containing span first.
+    //
+    // Invariants:
+    //  - live spans are disjoint; tmem_span_base[w] maps word w to (span base + 1), 0 = none;
+    //  - a live span's base slot always holds its word-0 view (payload fields identical to
+    //    the original StoreLoadedTexture argument) and is never stale: it doubles as the
+    //    span record interior materialization derives from;
+    //  - tmem_slot_stale[w] == 0 means loaded_texture[w] physically equals the logical
+    //    per-word view. Any slot holding a resource shared_ptr is fresh for the live span
+    //    covering it, so span removal releases exactly the refs the old eager clears did.
     LoadedTexture loaded_texture[512];
+    uint16_t tmem_span_base[512];  // 0 = no span covers this word; else span base word + 1
+    uint16_t tmem_span_words[512]; // valid at a span's base index only: the span's word count
+    uint8_t tmem_slot_stale[512];  // 1 = loaded_texture[word] needs (re)materialization
+    void MaterializeTmemSlot(uint16_t tmemWord);
+    inline const LoadedTexture& LoadedTextureAt(uint16_t tmemWord) {
+        if (tmem_slot_stale[tmemWord] != 0) {
+            MaterializeTmemSlot(tmemWord);
+        }
+        return loaded_texture[tmemWord];
+    }
+    LoadedTexture& MutableLoadedTextureAt(uint16_t tmemWord);
     // Emulated 4 KiB TMEM. Import decodes from here using only tile-descriptor state, like
     // hardware, which makes slot-reuse-heavy frames immune to stale per-slot load bookkeeping.
     uint8_t tmem[4096];
