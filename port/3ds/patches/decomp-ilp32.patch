+#define _GFX_STATIC_PTR_INIT(w0expr, x) \
+	{ .words32 = { (unsigned int)(w0expr), 0, (unsigned int)(unsigned long)(x), GDX_GFXW1_HOST_TAG } }
+#endif
 #else
