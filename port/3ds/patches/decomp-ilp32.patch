  * their own (unsigned int) cast. */
+#if defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ == 4
+/* 32-bit host (3DS): a plain cast leaves high32 == 0, making a real host pointer
+ * indistinguishable from a segmented token by value (the 3DS heap starts at
+ * 0x08000000 -- top byte 0x08 == segment 8, and static data sits at 0x00xxxxxx --
+ * top byte 0x00 == segment 0). GfxW1 stays 64-bit on every host, so the spare high
+ * half tags host pointers: the graphics bridge's existing "high32 set => host
+ * pointer" fast path recognizes exactly this tag on 32-bit builds and takes the
+ * low32 verbatim. A tagged low32 of 0 (NULL) is treated as NULL by the bridge.
+ * The tag value avoids 0 ("segmented/value") and 0xFFFFFFFF (the bridge's
+ * sign-extension exception). Keep in sync with port/n64_gfx_bridge.cpp. */
+#define GDX_GFXW1_HOST_TAG 0x47445831u /* "GDX1" */
+#define _GFXW1_PTR(x) (((GfxW1)GDX_GFXW1_HOST_TAG << 32) | (GfxW1)(unsigned long)(x))
+#else
 #define _GFXW1_PTR(x) ((GfxW1)(x))
+#endif
