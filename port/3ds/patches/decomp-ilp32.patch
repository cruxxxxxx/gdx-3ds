diff --git a/include/libc/stddef.h b/include/libc/stddef.h
index d753396..b4fbb99 100644
--- a/include/libc/stddef.h
+++ b/include/libc/stddef.h
@@ -3,7 +3,14 @@
 
 #include "PR/ultratypes.h"
 
+#if defined(PORT) && defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ == 4
+/* ILP32 host (3DS/devkitARM): GCC/newlib spell ptrdiff_t `int` (__PTRDIFF_TYPE__); s32
+ * is `long`-based here — size-identical but type-distinct, and a TU that also sees the
+ * compiler's <stddef.h> would get a conflicting-types error. Match the toolchain. */
+typedef int ptrdiff_t;
+#else
 typedef s32 ptrdiff_t;
+#endif
 
