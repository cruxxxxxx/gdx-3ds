+ * hosts: a 32-bit toolchain has no relocation that stores a symbol address into a
+ * 64-bit field ("initializer element is not constant" from GCC for (GfxW1)&sym), so
+ * the static gs* forms initialize the low/high halves separately through this arm --
+ * the address relocates into w1lo and the host-pointer tag is a plain constant in
+ * w1hi. */
+typedef struct {
+	unsigned int w0;
+	unsigned int _gfxw1Pad;
+	unsigned int w1lo;
+	unsigned int w1hi;
+} GwordsStatic32;
