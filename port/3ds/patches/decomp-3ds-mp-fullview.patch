+/* MP phase 3 (decomp-3ds-mp-fullview.patch, gdx3ds_fullview_shim.h): a fullview build draws only
+ * the local player's HUD, in the 1P layout; every other player's HUD functions still run, in the
+ * stock order of cases 2-4 below (lap announcements, interval bookkeeping, the reverse warning's
+ * level SE all live in them), with their display-list output rewound.
+ *
+ * The local player is drawn with numPlayersIndex 0, so its rows [0][k] of the position tables must
+ * hold the 1P positions. Stock only ever reads [0][0] (1P is player 0), so filling [0][1..3] with
+ * it is invisible to every other path. */
+
+static void Hud_GdxFullviewLayout(s32 k) {
+    s32(*tables[])[4][2] = {
+        sPlayerTimerPositions, sPlayerTimePositions, sEnergyOutlinePositions, sEnergyBarPositions,
+        sSpeedPositions,       sPositionPositions,   sLapPositions,           sIntervalPositions,
+        sReversePositions,     sLivesPositions,
+    };
+    s32 i;
+
+    for (i = 0; i < ARRAY_COUNT(tables); i++) {
+        tables[i][0][k][0] = tables[i][0][0][0];
+        tables[i][0][k][1] = tables[i][0][0][1];
+    }
+}
+
+/* The 1P race portrait for VS fullview (menus.c calls it for the local player only). The stock
+ * Hud_DrawRacePortraits is not reused, for two reasons. In a non-GP mode it draws
+ * gRacersByPosition[0], the race leader, not the player. It also advances the portrait update
+ * state (Hud_UpdateCharacterPortraits / Hud_UpdatePortraitScales), which a stock VS race never
+ * touches. This function only draws: player k's portrait at the 1P slot and its place label
+ * under it, the way GP labels the player's portrait. The GP highlight flash is left out, since it
+ * picks the player among six portraits and there is only one here. */
+Gfx* Hud_GdxFullviewDrawPortrait(Gfx* gfx, s32 k) {
+    Racer* racer = &gRacers[k];
+    s32 place = racer->position - 1;
+
+    gSPDisplayList(gfx++, D_8014940);
+    gDPPipeSync(gfx++);
+    gDPLoadTextureBlock(gfx++, gCharacterPortraitTextures[racer->character], G_IM_FMT_RGBA, G_IM_SIZ_16b, 32, 32, 0,
+                        G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD,
+                        G_TX_NOLOD);
+    gSPTextureRectangle(gfx++, 24 << 2, sPortraitYPosOffsets[0] << 2, (24 + 32) << 2,
+                        (sPortraitYPosOffsets[0] + 32) << 2, 0, 0, 0, 1 << 10, 1 << 10);
+    if ((place >= 0) && (place < ARRAY_COUNT(sPositionTextures))) {
+        gDPPipeSync(gfx++);
+        gDPLoadTextureBlock(gfx++, sPositionTextures[place], G_IM_FMT_RGBA, G_IM_SIZ_16b, 16, 6, 0,
+                            G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD,
+                            G_TX_NOLOD);
+        gSPTextureRectangle(gfx++, 24 << 2, sPortraitPositionYPos[0] << 2, (24 + 16) << 2,
+                            (sPortraitPositionYPos[0] + 6) << 2, 0, 0, 0, 1 << 10, 1 << 10);
+    }
+    return gfx;
+}
