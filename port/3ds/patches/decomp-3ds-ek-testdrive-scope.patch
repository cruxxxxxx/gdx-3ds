+ * section ever skips here (no scope) and the display list is the stock one. */
+#include "gdx3ds_dlb_shim.h"
+extern void gdx_dl_testdrive_scope(void);
+#define GDX_EK_TESTDRIVE_SCOPE() gdx_dl_testdrive_scope()
+#else
+#define GDX_DLB(sec)
+#define GDX_DL_SKIP(sec, view) 0
+#define GDX_EK_TESTDRIVE_SCOPE()
+#endif
+
 Gfx* func_xk2_800DF6FC(Gfx* gfx) {
 
     gSPDisplayList(gfx++, D_30004A8);
     gSPDisplayList(gfx++, D_9014AA0);
 
     if (gInCourseEditTestRun) {
+        GDX_EK_TESTDRIVE_SCOPE();
         gSPMatrix(gfx++, D_2000000, G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
         gDPPipeSync(gfx++);
         gDPPipelineMode(gfx++, G_PM_1PRIMITIVE);
         gDPSetTextureFilter(gfx++, G_TF_BILERP);
-        gfx = Background_Draw(gfx, 0, SCISSOR_BOX_FULL_SCREEN);
-        gfx = Course_Draw(gfx, 0);
-        gfx = Course_GadgetsDraw(gfx, 0);
+        GDX_DLB(SKY);
+        if (!GDX_DL_SKIP(SKY, 0)) {
+            gfx = Background_Draw(gfx, 0, SCISSOR_BOX_FULL_SCREEN);
+        }
+        GDX_DLB(TRK);
+        if (!GDX_DL_SKIP(TRK, 0)) {
+            gfx = Course_Draw(gfx, 0);
+        }
+        GDX_DLB(DRESS);
+        if (!GDX_DL_SKIP(DRESS, 0)) {
+            gfx = Course_GadgetsDraw(gfx, 0);
+        }
+        GDX_DLB(RMID);
         gSPLoadUcodeL(gfx++, gspF3DFLX2_Rej_fifo);
         func_xk2_800E1FC0(&gfx);
         gfx = Racer_Draw(gfx, 0);
+        GDX_DLB(RMID);
         gSPLoadUcodeL(gfx++, gspF3DEX2_fifo);
         gSPMatrix(gfx++, D_2000000, G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
         func_xk2_800E1FC0(&gfx);
