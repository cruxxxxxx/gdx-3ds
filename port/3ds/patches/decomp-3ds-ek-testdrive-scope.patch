 extern u8 D_xk2_80104CA0[];
 
+#if defined(PORT) && defined(GDX_PLATFORM_3DS)
+/* S5b [native] nrr_testdrive (port/3ds/gdx3ds_c5tick.c, o3dsek-plan.md section 6): the test drive
+ * draws a race -- sky, course, gadgets, the one racer -- from here, outside Race_Draw, so the c5tick
+ * race scope never opened for it and every NRR category drew it on the legacy interpreter. The
+ * scope call opens that scope (a no-op with the lever off) and the section markers below are
+ * Race_Draw's own 1P ones, so each consumed section's stub replaces its call exactly as it does in
