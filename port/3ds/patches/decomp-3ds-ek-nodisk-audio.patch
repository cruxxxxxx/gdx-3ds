@@ -767,6 +767,36 @@
     return fontData;
 }
 
+#ifdef PORT
+/* No disk mounted (an EK build booted without its .ndd): every MEDIUM_LBA load would issue a
+   LeoReadWrite that fails with DRIVE_NOT_READY and copies nothing, yet the caller still marks
+   the entry loaded -- so the "sequence" it then plays is whatever the audio heap held at that
+   address. Measured on test-combined (n3ds-ek, no .ndd, menus-longtail): the producer thread
+   spins forever inside AudioSynth_Update on that stale script while holding sAudioCtxMutex, and
+   the game fiber parks in AudioThread_QueueCmd behind it (frame ~127, ctx=0+1). Which bytes the
+   heap held depends on the binary's layout, which is why one build hangs and its neighbour does
+   not. Refuse the load up front instead, the way an allocation failure already does: no disk,
+   no disk audio. (An async refusal still posts its completion; external.c's Audio_CheckBgmLoad
+   stops waiting for a BGM that can never load -- both are needed so the race countdown and
+   sys_gfx.c's func_807424CC wait do not hold forever.) A mounted disk never takes this path, so every byte of a disk run is
+   unchanged. */
+static s32 AudioLoad_PortRefuseDiskless(const char* what, u32 tableType, u32 id, u32 medium) {
+    extern int gdx_leo_disk_mounted(void);
+    extern void gdx_ek_note(const char* what, unsigned int a, unsigned int b, unsigned int c,
+                            unsigned int d);
+    static s32 sDisklessLogs = 0;
+
+    if (medium != MEDIUM_LBA || gdx_leo_disk_mounted()) {
+        return false;
+    }
+    if (sDisklessLogs < 4) {
+        sDisklessLogs++;
+        gdx_ek_note(what, tableType, id, medium, 0u);
+    }
+    return true;
+}
+#endif
