+/* EK_NIMACH ([native] ek_nimach + ni_mach bit 1): the Expansion Kit's machine select grid as ONE NRR
+ * mach marker -- MachineSelect_NimachMachines (decomp-3ds-nimach.patch) with the EK loop's
+ * differences: every slot draws under G_RM_PASS / G_RM_AA_ZB_OPA_SURF2 (written once before the
+ * marker; the body lists never set a render mode, so that is also the state the stock loop leaves),
+ * the env colour is the EK func_8009CCBC's, and a player-designed machine is always a stock slot.
+ * Stock slots follow the marker (the not-yet-recorded ones arm the recorder). Returns NULL when the
+ * NRR took nothing (the caller writes the stock loop over these words). No game state is written. */
+static Gfx* MachineSelect_EkNimachMachines(Gfx* gfx, Object* machineObj) {
+    static GdxNrrMachMenuSnap sSnap;
+    GdxNrrMachMenuSnap* f = &sSnap;
+    Gfx* out;
+    u32 legacy = 0;
+    u32 stockOnly = 0;
+    s32 fallback = 0;
+    s32 i;
+    s32 j;
+    s32 k;
+
+    f->n = 0;
+    f->rec = 0;
+    f->ctx = GDX_NRR_MACH_CTX_SELECT;
+    for (j = 0; j < 2; j++) {
+        Lights1* lights = &gGfxPool->unk_21A88[j];
+        for (k = 0; k < 3; k++) {
+            f->ldir[j][k] = lights->l[0].l.dir[k];
+            f->lcol[j][k] = lights->l[0].l.col[k];
+            f->amb[j][k] = lights->a.l.col[k];
+        }
+    }
+    for (i = 0; i < 30; i++) {
+        s32 character = Character_GetCharacterFromSlot(i);
+        GdxNrrMachMenuEnt* e;
+        const s32* words;
+        const Vp* vp = MACHINE_VIEWPORT(machineObj) + i;
+
+        if (EkNimach_StockOnly(character)) {
+            stockOnly |= 1u << i;
+            continue;
+        }
+        if (!gdx3ds_nrr_mach_ready(character * 6, GDX_NRR_MACH_MBODY)) {
+            legacy |= 1u << i;
+            fallback++;
+            continue;
+        }
+        e = &f->e[f->n++];
+        words = (const s32*) &gGfxPool->unk_20308[MachineSelect_EkNimachSelected(i) ? 0 : 1];
+        for (k = 0; k < 16; k++) {
+            e->mtx[k] = words[k];
+        }
+        for (k = 0; k < 4; k++) {
+            e->vp[k] = vp->vp.vscale[k];
+            e->vp[4 + k] = vp->vp.vtrans[k];
+        }
+        e->idx = character * 6;
+        e->kind = GDX_NRR_MACH_MBODY;
+        EkNimach_EnvColor(e->rgb, character, 0);
+        e->light = (i < sMachinesUnlocked) ? 0 : 1;
+    }
+    f->rec = legacy != 0;
+    gDPSetRenderMode(gfx++, G_RM_PASS, G_RM_AA_ZB_OPA_SURF2);
+    out = gdx3ds_nrr_mach_menu_publish(gfx, f, fallback);
+    gdx_ek_nimach_note(GDX_NRR_MACH_CTX_SELECT, out != NULL ? f->n : 0, (s32) __builtin_popcount(stockOnly));
+    if (out == NULL) {
+        return NULL;
+    }
+    gfx = out;
+    for (i = 0; i < 30; i++) {
+        if ((legacy | stockOnly) & (1u << i)) {
+            gfx = MachineSelect_EkNimachStock(gfx, machineObj, i);
+        }
+    }
+    if (!((legacy | stockOnly) & (1u << 29))) {
+        j = (29 < sMachinesUnlocked) ? 0 : 1;
+        gDPPipeSync(gfx++);
+        gSPLight(gfx++, &D_1000000.unk_21A88[j].l[0], 1);
+        gSPLight(gfx++, &D_1000000.unk_21A88[j].a, 2);
+        gSPViewport(gfx++, MACHINE_VIEWPORT(machineObj) + 29);
+        gSPMatrix(gfx++, &D_1000000.unk_20308[MachineSelect_EkNimachSelected(29) ? 0 : 1],
+                  G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+        gDPSetRenderMode(gfx++, G_RM_PASS, G_RM_AA_ZB_OPA_SURF2);
+    }
+    return gfx;
+}
