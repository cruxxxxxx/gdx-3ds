+/* EK_NIMACH: func_8009CCBC's env colour on the Expansion Kit (a default machine is drawn grey while
+ * gGreyscaleMachinePart is set). */
+static void EkNimach_EnvColor(u8* rgb, s32 character, s32 skin) {
+    Machine* machine = &gMachines[character];
+    s32 color;
+
+    if (gGreyscaleMachinePart && (machine->customType == CUSTOM_MACHINE_DEFAULT)) {
+        color = (machine->red[skin] * 77) + (machine->green[skin] * 151) + (machine->blue[skin] * 28);
+        color >>= 8;
+        rgb[0] = color;
+        rgb[1] = color;
+        rgb[2] = color;
+    } else {
+        rgb[0] = machine->red[skin];
+        rgb[1] = machine->green[skin];
+        rgb[2] = machine->blue[skin];
+    }
+}
 
+/* EK_NIMACH: a player-designed machine (CUSTOM_MACHINE_EDITED: body and texture lists the game builds
+ * at run time from the design) always draws the stock way. */
+static s32 EkNimach_StockOnly(s32 character) {
+    return gMachines[character].customType == CUSTOM_MACHINE_EDITED;
+}
