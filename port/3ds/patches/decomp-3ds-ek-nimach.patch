+#if defined(PORT) && defined(GDX_PLATFORM_3DS) && defined(EXPANSION_KIT)
+static void MachineSettings_EkNimachEnt(GdxNrrMachMenuSnap* f, Mtx* mtx, Object* machineObj, s32 i) {
+    GdxNrrMachMenuEnt* e = &f->e[f->n++];
+    const s32* words = (const s32*) mtx;
+    const Vp* vp = MACHINE_VIEWPORT(machineObj) + i;
+    s32 k;
+
+    for (k = 0; k < 16; k++) {
+        e->mtx[k] = words[k];
+    }
+    for (k = 0; k < 4; k++) {
+        e->vp[k] = vp->vp.vscale[k];
+        e->vp[4 + k] = vp->vp.vtrans[k];
+    }
+    e->idx = gRacers[i].character * 6;
+    e->kind = GDX_NRR_MACH_MSBODY;
+    EkNimach_EnvColor(e->rgb, gRacers[i].character, gRacers[i].machineSkinIndex);
+    e->light = 0;
+}
