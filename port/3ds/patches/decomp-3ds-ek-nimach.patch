+/* EK_NIMACH: one machine slot's stock commands (the EK loop body of MachineSelect_MachineDraw, with
+ * its render mode). */
+static Gfx* MachineSelect_EkNimachStock(Gfx* gfx, Object* machineObj, s32 i) {
+    s32 j = (i < sMachinesUnlocked) ? 0 : 1;
+
+    gDPPipeSync(gfx++);
+    gSPLight(gfx++, &D_1000000.unk_21A88[j].l[0], 1);
+    gSPLight(gfx++, &D_1000000.unk_21A88[j].a, 2);
+    gSPViewport(gfx++, MACHINE_VIEWPORT(machineObj) + i);
+    gSPMatrix(gfx++, &D_1000000.unk_20308[MachineSelect_EkNimachSelected(i) ? 0 : 1],
+              G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    gDPSetRenderMode(gfx++, G_RM_PASS, G_RM_AA_ZB_OPA_SURF2);
+    return func_8009CCBC(gfx, Character_GetCharacterFromSlot(i), 0);
+}
