+static s32 MachineSelect_EkNimachSelected(s32 i) {
+    s32 j;
+
+    for (j = 0; j < gNumPlayers; j++) {
+        if (i == sMachineSelectIndex[j]) {
+            return true;
+        }
+    }
+    return false;
+}
