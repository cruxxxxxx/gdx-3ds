+/* EK_NIMACH ([native] ek_nimach + ni_mach bit 2): machine settings / GP next machine on the Expansion
+ * Kit -- MachineSettings_NimachBodies (decomp-3ds-nimach.patch) with the EK env colour, and a
+ * player-designed machine always a stock body. Makes the stock pass's game-state write
+ * (Lights_SetSource) first; returns NULL when the NRR took nothing (the caller writes the stock pass;
+ * Lights_SetSource writes the same values again). */
+static Gfx* MachineSettings_EkNimachBodies(Gfx* gfx, Object* machineObj) {
+    static GdxNrrMachMenuSnap sSnap;
+    GdxNrrMachMenuSnap* f = &sSnap;
+    Gfx* out;
+    u32 legacy = 0;
+    u32 stockOnly = 0;
+    s32 fallback = 0;
+    s32 last = gNumPlayers - 1;
+    s32 i;
+    s32 k;
+
+    if ((gNumPlayers < 1) || (gNumPlayers > 4)) {
+        return NULL;
+    }
+    Lights_SetSource(gGfxPool->unk_21A88, 0, 0, 0, 255, 255, 255, 50, 25, 34);
+    f->n = 0;
+    f->ctx = GDX_NRR_MACH_CTX_SETTINGS;
+    for (k = 0; k < 3; k++) {
+        f->ldir[0][k] = f->ldir[1][k] = gGfxPool->unk_21A88[0].l[0].l.dir[k];
+        f->lcol[0][k] = f->lcol[1][k] = gGfxPool->unk_21A88[0].l[0].l.col[k];
+        f->amb[0][k] = f->amb[1][k] = gGfxPool->unk_21A88[0].a.l.col[k];
+    }
+    for (i = 0; i < gNumPlayers; i++) {
+        if (EkNimach_StockOnly(gRacers[i].character)) {
+            stockOnly |= 1u << i;
+        } else if (gdx3ds_nrr_mach_ready(gRacers[i].character * 6, GDX_NRR_MACH_MSBODY)) {
+            MachineSettings_EkNimachEnt(f, &gGfxPool->unk_20308[i], machineObj, i);
+        } else {
+            legacy |= 1u << i;
+            fallback++;
+        }
+    }
+    f->rec = legacy != 0;
+    gSPDisplayList(gfx++, D_303A5F8);
+    gSPLight(gfx++, &D_1000000.unk_21A88[0].l[0], 1);
+    gSPLight(gfx++, &D_1000000.unk_21A88[0].a, 2);
+    out = gdx3ds_nrr_mach_menu_publish(gfx, f, fallback);
+    gdx_ek_nimach_note(GDX_NRR_MACH_CTX_SETTINGS, out != NULL ? f->n : 0, (s32) __builtin_popcount(stockOnly));
+    if (out == NULL) {
+        return NULL;
+    }
+    gfx = out;
+    for (i = 0; i < gNumPlayers; i++) {
+        if ((legacy | stockOnly) & (1u << i)) {
+            gSPViewport(gfx++, MACHINE_VIEWPORT(machineObj) + i);
+            gSPMatrix(gfx++, &D_1000000.unk_20308[i], G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+            gfx = func_8009CCBC(gfx, gRacers[i].character, gRacers[i].machineSkinIndex);
+        }
+    }
+    if (!((legacy | stockOnly) & (1u << last))) {
+        gSPViewport(gfx++, MACHINE_VIEWPORT(machineObj) + last);
+        gSPMatrix(gfx++, &D_1000000.unk_20308[last], G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    }
+    return gfx;
+}
