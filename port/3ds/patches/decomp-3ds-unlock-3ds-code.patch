 const u16 gUnlockEverythingInputs[] = { BTN_L, BTN_Z, BTN_R, BTN_CUP, BTN_CDOWN, BTN_CLEFT, BTN_CRIGHT, BTN_START };
+
+#ifdef PORT
+/* 3DS: the stock code needs N64 L (no 3DS button maps to it) and the C buttons (no C-stick on an
+ * Old 3DS), so the port also takes a 3DS-native code at SELECT MODE: L, R, D-Up, D-Down, D-Left,
+ * D-Right, START -- in N64 terms Z (3DS L / X), R, the D-pad and START, on press edges. The stock
+ * code keeps working; either one completes the same unlock (the stock flag, save and sound). */
+static const u16 sGdxUnlockEverythingAltInputs[] = { BTN_Z, BTN_R, BTN_UP, BTN_DOWN, BTN_LEFT, BTN_RIGHT, BTN_START };
+#define GDX_UNLOCK_ALT_STEPS ((s32) (sizeof(sGdxUnlockEverythingAltInputs) / sizeof(sGdxUnlockEverythingAltInputs[0])))
+static s32 sGdxUnlockAltStep = 0;
 
+static void MainMenu_UnlockEverythingComplete(Object* unlockEverythingObj);
+
+static void MainMenu_UnlockEverythingAltReset(void) {
+    sGdxUnlockAltStep = 0;
+}
+
+static bool MainMenu_UnlockAwaitsStart(void) {
+    return (OBJECT_STATE(Object_Get(OBJECT_MAIN_MENU_UNLOCK_EVERYTHING)) == 7) ||
+           (sGdxUnlockAltStep == GDX_UNLOCK_ALT_STEPS - 1);
+}
+
+/* One press edge against the 3DS code: 1 when it completes it. */
+static bool MainMenu_UnlockEverythingAltStep(void) {
+    if ((sGdxUnlockAltStep > 0) && (sGdxUnlockEverythingAltInputs[sGdxUnlockAltStep - 1] & gInputButtonPressed) &&
+        !(sGdxUnlockEverythingAltInputs[sGdxUnlockAltStep] & gInputButtonPressed)) {
+        /* The input just taken, again: a D-pad press is also the stick's edge a frame later. */
+        return false;
+    } else if (sGdxUnlockEverythingAltInputs[sGdxUnlockAltStep] & gInputButtonPressed) {
+        sGdxUnlockAltStep++;
+    } else if (sGdxUnlockEverythingAltInputs[0] & gInputButtonPressed) {
+        sGdxUnlockAltStep = 1;
+    } else {
+        sGdxUnlockAltStep = 0;
+    }
+    gdx_unlock_diagf("[unlock] 3ds code edge=0x%04X step=%d/%d\n", gInputButtonPressed, sGdxUnlockAltStep,
+                     GDX_UNLOCK_ALT_STEPS);
+    if (sGdxUnlockAltStep < GDX_UNLOCK_ALT_STEPS) {
+        return false;
+    }
+    sGdxUnlockAltStep = 0;
+    return true;
+}
+#endif
