diff --git a/include/gdx_snap_section.h b/include/gdx_snap_section.h
new file mode 100644
--- /dev/null
+++ b/include/gdx_snap_section.h
@@ -0,0 +1,26 @@
+#ifndef GDX_SNAP_SECTION_H
+#define GDX_SNAP_SECTION_H
+
+/* mp-snapshot (decomp-3ds-snapshot.patch; port/gdx_snapshot.h, port/3ds/gdx3ds_snapshot_bss.ld).
+ * The snapshot linker fragments group every decomp TU's .data / .bss / COMMON into the snapshot
+ * blocks. These move one object back OUT of them:
+ *   GDX_NOSNAP        boot-time and course-load tables. Never restored; watched by the gate, which
+ *                     proves a race tick does not write them.
+ *   GDX_NOSNAP_DRAW   course-load tables whose fields the draw pass rewrites every frame before
+ *                     reading them (gSegmentChunks: depth / drawState). Never restored, not watched.
+ *   GDX_NOSNAP_SCHED  the scheduler's objects (thread stacks -- unused, the port's fibers own their
+ *                     stacks -- OSThread, OSMesgQueue and their message buffers): they describe the
+ *                     same parked state at every tick boundary and must never be rewound under the
+ *                     scheduler. Not watched: they change every tick.
+ * Empty off the 3DS build. */
+#if defined(PORT) && defined(__3DS__)
+#define GDX_NOSNAP __attribute__((section(".bss.gdx_nosnap")))
+#define GDX_NOSNAP_DRAW __attribute__((section(".bss.gdx_nosnap_draw")))
+#define GDX_NOSNAP_SCHED __attribute__((section(".bss.gdx_nosched")))
+#else
+#define GDX_NOSNAP
+#define GDX_NOSNAP_DRAW
+#define GDX_NOSNAP_SCHED
+#endif
+
+#endif /* GDX_SNAP_SECTION_H */
