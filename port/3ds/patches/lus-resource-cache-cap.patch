+void ResourceManager::SetCacheByteBudget(size_t bytes) {
+    // Declared before the lock guard: evicted resources must destruct after the mutex
+    // is released (resource destructors may re-enter the resource manager).
+    std::vector<std::shared_ptr<IResource>> evicted;
+    {
+        const std::lock_guard<std::mutex> lock(mMutex);
+        mCacheByteBudget = bytes;
+        EnforceCacheBudgetLocked(evicted);
+    }
+}
+
+size_t ResourceManager::GetCacheByteSize() {
+    const std::lock_guard<std::mutex> lock(mMutex);
+    return mCacheBytes;
+}
+
+void ResourceManager::AccountCacheInsertLocked(const ResourceIdentifier& identifier,
+                                               const std::shared_ptr<IResource>& resource) {
+    auto& accounting = mCacheAccounting[identifier];
+    // Re-inserts (dirty reload, another thread winning the race) replace the old accounting.
+    mCacheBytes -= accounting.Bytes;
+    accounting.Bytes = resource != nullptr ? resource->GetPointerSize() : 0;
+    accounting.Tick = ++mCacheTick;
+    mCacheBytes += accounting.Bytes;
+}
+
+void ResourceManager::DropCacheAccountingLocked(const ResourceIdentifier& identifier) {
+    auto accounting = mCacheAccounting.find(identifier);
+    if (accounting == mCacheAccounting.end()) {
+        return;
+    }
+    mCacheBytes -= accounting->second.Bytes;
+    mCacheAccounting.erase(accounting);
 }
 
+void ResourceManager::EnforceCacheBudgetLocked(std::vector<std::shared_ptr<IResource>>& evicted) {
+    if (mCacheByteBudget == 0 || mCacheBytes <= mCacheByteBudget) {
+        return;
+    }
+    const size_t bytesBefore = mCacheBytes;
+    // O(entries) scan per eviction: evictions only happen under budget pressure and the
+    // cache holds a few thousand entries at most, so the simple scan beats threading an
+    // intrusive LRU list through the variant-valued cache map.
+    while (mCacheBytes > mCacheByteBudget) {
+        const ResourceIdentifier* lruKey = nullptr;
+        uint64_t lruTick = UINT64_MAX;
+        for (const auto& [key, accounting] : mCacheAccounting) {
+            if (accounting.Tick >= lruTick) {
+                continue;
+            }
+            auto entry = mResourceCache.find(key);
+            if (entry == mResourceCache.end()) {
+                continue;
+            }
+            auto* held = std::get_if<std::shared_ptr<IResource>>(&entry->second);
+            if (held == nullptr || *held == nullptr || held->use_count() > 1) {
+                // Load-error entries cost nothing; externally referenced resources are
+                // pinned — evicting them could not free their memory anyway.
+                continue;
+            }
+            lruTick = accounting.Tick;
+            lruKey = &key;
+        }
+        if (lruKey == nullptr) {
+            break; // everything left is pinned; stay over budget until references drop
+        }
+        const ResourceIdentifier key = *lruKey;
+        auto entry = mResourceCache.find(key);
+        evicted.push_back(std::get<std::shared_ptr<IResource>>(entry->second));
+        mResourceCache.erase(entry);
+        DropCacheAccountingLocked(key);
+    }
+    if (!evicted.empty()) {
+        SPDLOG_DEBUG("Resource cache budget: evicted {} entries ({} -> {} bytes, budget {})", evicted.size(),
+                     bytesBefore, mCacheBytes, mCacheByteBudget);
+    }
+}
