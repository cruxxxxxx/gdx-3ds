+#ifdef GDX_PLATFORM_3DS
+/* gdx 3DS: a NULL string reaches a stock font draw only through port code (b5f620a: the MP pickers
+ * restored a NULL gCurrentTrackName). Hardware faults on it, the emulator reads zeros and hides it;
+ * either way log "[nullread]" (the first 8, with the caller) and draw nothing. */
+static s32 sGdxFontNullReads = 0;
+
+static void GdxFontNullRead(const char* fn, void* caller) {
+    extern void gdx_dbg_logf(const char* fmt, ...);
+    if (sGdxFontNullReads < 8) {
+        sGdxFontNullReads++;
+        gdx_dbg_logf("[nullread] %s str=NULL caller=%p (#%d)\n", fn, caller, (int) sGdxFontNullReads);
+    }
+}
+#endif
