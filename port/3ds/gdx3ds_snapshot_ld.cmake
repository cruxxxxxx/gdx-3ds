# port/3ds/gdx3ds_snapshot_ld.cmake -- mp-snapshot: group the simulation state into contiguous blocks.
#
# devkitARM links a 3dsx with `-specs=3dsx.specs`, whose link spec passes `-T 3dsx.ld`. An augmenting
# INSERT script cannot be used against it (ld only INSERTs into its built-in default script, or into
# a -T script that comes AFTER the INSERT one, and the specs' -T always comes first), so this builds
# the link's script instead:
#
#   1. read the INSTALLED 3dsx.ld (gcc -print-file-name) and add one `INCLUDE` line at the top of its
#      `.data` and of its `.bss` output sections -- the two fragments, gdx3ds_snapshot_data.ld and
#      gdx3ds_snapshot_bss.ld, hold the actual placement and its rationale;
#   2. write a specs file that redefines `*link:` as gcc's built-in link spec plus 3dsx.specs' own
#      addition with `-T 3dsx.ld%s` swapped for the generated script.
#
# Every anchor is checked: a devkitARM update that changes them stops the configure instead of
# silently linking the stock layout. Nothing else in the stock script changes, so the image differs
# from the stock link only by the order of input sections inside .data and .bss.
#
# Contract: port/3ds/gdx_snapshot.c reads the __gdx_snap_* bounds (weak: a link without this script
# leaves them 0 and the module refuses to arm).

function(gdx3ds_snapshot_link_setup target)
    set(fragData "${CMAKE_CURRENT_SOURCE_DIR}/gdx3ds_snapshot_data.ld")
    set(fragBss "${CMAKE_CURRENT_SOURCE_DIR}/gdx3ds_snapshot_bss.ld")
    set(outDir "${CMAKE_CURRENT_BINARY_DIR}/gdx3ds_snapshot")
    set(outLd "${outDir}/gdx3ds_3dsx_snapshot.ld")
    set(outSpecs "${outDir}/gdx3ds_snapshot.specs")

    execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-file-name=3dsx.ld
                    OUTPUT_VARIABLE stockLd OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-file-name=3dsx.specs
                    OUTPUT_VARIABLE stockSpecs OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND "${CMAKE_C_COMPILER}" -dumpspecs
                    OUTPUT_VARIABLE builtinSpecs)
    if(NOT EXISTS "${stockLd}" OR NOT EXISTS "${stockSpecs}")
        message(FATAL_ERROR "mp-snapshot: devkitARM 3dsx.ld / 3dsx.specs not found ('${stockLd}', '${stockSpecs}')")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${stockLd}" "${stockSpecs}")

    # 1. the script
    file(READ "${stockLd}" script)
    gdx3ds_snapshot_insert_after(script "\t.data :\n\t{\n" "\t\tINCLUDE \"${fragData}\"\n")
    gdx3ds_snapshot_insert_after(script "\t.bss ALIGN(4) :\n\t{\n" "\t\tINCLUDE \"${fragBss}\"\n")
    file(WRITE "${outLd}"
         "/* GENERATED by port/3ds/gdx3ds_snapshot_ld.cmake from ${stockLd}. Do not edit. */\n${script}")

    # 2. the specs
    string(REGEX MATCH "\\*link:\n([^\n]*)\n" builtinMatch "${builtinSpecs}")
    if(NOT builtinMatch)
        message(FATAL_ERROR "mp-snapshot: no *link: in `gcc -dumpspecs`")
    endif()
    set(builtinLink "${CMAKE_MATCH_1}")
    file(READ "${stockSpecs}" specs)
    string(REGEX MATCH "\\*link:\n\\+ ([^\n]*)\n" stockMatch "${specs}")
    set(stockLink "${CMAKE_MATCH_1}")
    string(FIND "${stockLink}" "-T 3dsx.ld%s" tPos)
    if(NOT stockMatch OR tPos LESS 0)
        message(FATAL_ERROR "mp-snapshot: 3dsx.specs link spec changed (expected '*link:\\n+ -T 3dsx.ld%s ...')")
    endif()
    string(REPLACE "-T 3dsx.ld%s" "-T ${outLd}" snapLink "${stockLink}")
    file(WRITE "${outSpecs}"
         "# GENERATED by port/3ds/gdx3ds_snapshot_ld.cmake. Do not edit.\n\n*link:\n${builtinLink} ${snapLink}\n\n")

    # -specs files apply in command-line order: this one follows CMAKE_EXE_LINKER_FLAGS' 3dsx.specs.
    target_link_options(${target} PRIVATE "-specs=${outSpecs}")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${outLd}" "${outSpecs}" "${fragData}" "${fragBss}")
endfunction()

function(gdx3ds_snapshot_insert_after varName anchor addition)
    string(FIND "${${varName}}" "${anchor}" at)
    if(at LESS 0)
        message(FATAL_ERROR "mp-snapshot: 3dsx.ld anchor not found: '${anchor}'")
    endif()
    string(REPLACE "${anchor}" "${anchor}${addition}" replaced "${${varName}}")
    if(replaced STREQUAL "${${varName}}")
        message(FATAL_ERROR "mp-snapshot: 3dsx.ld anchor did not apply: '${anchor}'")
    endif()
    set(${varName} "${replaced}" PARENT_SCOPE)
endfunction()
