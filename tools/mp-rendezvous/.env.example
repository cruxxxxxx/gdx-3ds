# Copy to .env next to docker-compose.yml and edit. Every value here has a default.

# --- the server -------------------------------------------------------------------------------
RV_PORT=27200                 # the UDP port consoles use ([net] rendezvous = <your IPv4>:27200)
RV_LOG_IP=full                # full | prefix (/24) | hash | none: how source IPs appear in the log
RV_METRICS_BIND=127.0.0.1     # /metrics listens here (port 9727); keep it off the internet
# RV_LOKI_URL=http://127.0.0.1:3100/loki/api/v1/push   # with --profile monitoring: ship the access log
# RV_ARGS=--max-rooms 500 --relay-pps 400 --room-bps 196608   # any other server flags
# RV_ARGS=--update-url example.org/update    # shown with UPDATE REQUIRED (40 chars max)
# RV_ARGS=--allow-v1                         # also admit cards before the cookie build (legacy)
# RV_ARGS=--min-client-proto 8               # keep the previous release playing for a while

# --- monitoring (docker compose --profile monitoring up -d) ----------------------------------
DATA_DIR=./data               # Prometheus, Loki and Grafana data (chown it to DATA_UID:DATA_GID)
DATA_UID=65534
DATA_GID=65534
PROM_RETENTION=30d
LOKI_RETENTION=336h           # 14 days
GRAFANA_BIND=127.0.0.1        # reach it with an SSH tunnel: ssh -L 3000:127.0.0.1:3000 you@host
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD_FILE=./grafana-admin-password   # openssl rand -base64 18 > grafana-admin-password
PROBE_TARGET=127.0.0.1:27200  # or your public IPv4:27200 to test the router forward too
